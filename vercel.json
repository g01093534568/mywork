{
  "rewrites": [
    {
      "source": "/",
      "destination": "/worklog-app.Html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/remind",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/water-bill",
      "schedule": "0 1 10 * *"
    }
  ],
  "functions": {
    "api/water-bill.js": {
      "includeFiles": "fonts/**",
      "memory": 2048,
      "maxDuration": 60
    },
    "api/cron/water-bill.js": {
      "includeFiles": "fonts/**",
      "memory": 2048,
      "maxDuration": 300
    }
  }
}
